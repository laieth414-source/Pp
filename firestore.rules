rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
    }

    // Prompts Collection: Publicly readable, authenticated create/update
    match /prompts/{promptId} {
      allow read: if true;
      allow create: if isValidId(promptId) && (
        isSignedIn() || true // allow initial seed / guest contribution if enabled
      );
      allow update: if isValidId(promptId);
      allow delete: if isSignedIn();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isSignedIn();
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
